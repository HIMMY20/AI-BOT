APP_NAME=Delta AI Trading Platform
DATABASE_URL=sqlite:///./data/delta_ai.db
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=REPLACE_WITH_YOUR_OWN_STRONG_PASSWORD
# Public market data source. Use live for live public tickers/candles.
DELTA_ENV=live
# Order execution is intentionally unavailable in this build.
ENABLE_DEMO_ORDERS=false
ENABLE_LIVE_ORDERS=false
RISK_PER_TRADE_PCT=0.5
MAX_DAILY_LOSS_PCT=2.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
